rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events: anyone can read (for polls/invites), authenticated users can write
    // Unauthenticated users can update (for poll RSVP/voting member registration)
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null;

      // Date options: anyone can read and vote (for unauthenticated poll participants)
      match /dateOptions/{optionId} {
        allow read, write: if true;
      }

      // Chat: authenticated users only
      match /chat/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Expenses: charges pushed in from Wealth Architect, split between people.
    // Tighter than events on purpose — an event is readable by anonymous poll
    // participants, but what someone owes is nobody else's business, so this
    // needs a signed-in user. Writes from the ingest endpoint use the Admin
    // SDK and bypass these rules entirely.
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    // Which pages the owner has hidden from everyone else (appConfig/pageVisibility).
    // Every signed-in user has to be able to READ this — a viewer can only hide
    // a page if they know it's hidden — but only the owner may change it.
    // This governs what the app renders, not what the data rules allow: a page
    // hidden here still sits on top of collections whose own rules decide who
    // can read them.
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == 'baldaufdan@gmail.com';
    }

    // Users: only the owner can read/write their own data.
    // The admin (by email) can read every user doc to power the admin page.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.token.email == 'baldaufdan@gmail.com');
      allow write: if request.auth != null && request.auth.uid == userId;

      // Friends subcollection
      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
