<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. "production" is correct for TestFlight and
	     App Store builds, which is all this workflow produces; it must stay in
	     step with APNS_PRODUCTION on Vercel (see PUSH_SETUP.md). A debug build
	     run from Xcode would need "development" instead. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
